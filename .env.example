# Server-side WhatsApp registration checks (no outbound messages).
WA_AKG_URL=
WA_AKG_API_KEY=
WA_AKG_SESSION_ID=

# Existing application settings. Use your own secrets; never commit them.
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
MCP_TOKEN=
CRON_SECRET=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
ANTHROPIC_API_KEY=

# Private VPS worker credential (32+ random characters). Gateway key stays on VPS.
WA_BRIDGE_SECRET=

# Signed inbound WA-AKG webhooks: separate secret and allowed sessionId.
WA_WEBHOOK_SECRET=
WA_WEBHOOK_SESSION_ID=

# Reviewed campaign sender: disabled unless explicitly configured.
# Use test first; only configured personal test numbers may receive messages.
WA_SEND_MODE=disabled
WA_SENDER_SECRET=
WA_SENDER_TEST_NUMBERS=
